# Database connection (SQLite for local dev, PostgreSQL for production)
DATABASE_URL="file:./dev.db"
# Or PostgreSQL: DATABASE_URL="postgresql://user:password@localhost:5432/luxeos?schema=public"

# Session Security Key
NEXTAUTH_SECRET="your-super-secret-session-encryption-key"

# AES-256 Symmetric Key for encrypting SMTP credentials at rest
SMTP_ENCRYPTION_KEY="your-aes256-smtp-encryption-key"

# Base Application URL
APP_URL="https://os.theluxestudio.in"

